GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Total attempts (including the first) for a Gemini call that hits a
# transient error before giving up. Each retry is a billed API call.
# Default is 1 (no retry); raise it if you want resilience against
# transient overload and are fine paying for the extra attempts.
GEMINI_MAX_RETRIES=1

# Mock mode: no real Lean toolchain needed. Leave LEAN_PROJECT_DIR unset.
ALLOW_MOCK_FALLBACK=true
